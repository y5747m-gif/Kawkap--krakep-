{
  "name": "kawkap-krakeb",
  "version": "1.0.0",
  "private": true,
  "description": "كوكب كراكيب — منصة Marketplace ليبيع العملاء ما لا يحتاجونه. العملاء هم البائعون والمشترون، والمالك يدير المنصة ويستقبل الطلبات مركزيًا عبر WhatsApp.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/check-runtime.mjs",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "next build",
    "prestart": "node scripts/check-runtime.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "rm -f data/app.db* && npm run db:seed"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "16.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
