# اختياري: مسار SQLite على قرص دائم. عند حذفه يُستخدم data/app.db محليًا.
# في الاستضافة التقليدية اربطه بمجلد Persistent Volume، مثل /var/data/app.db.
KK_DB_PATH="./data/app.db"

# رابط الموقع (يُستخدم في روابط المنتجات داخل رسائل واتساب) — بدون شرطة مائلة في النهاية
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
