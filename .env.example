# اختياري: مسار SQLite على قرص دائم. عند حذفه يُستخدم data/app.db محليًا.
# في الاستضافة التقليدية اربطه بمجلد Persistent Volume، مثل /var/data/app.db.
KK_DB_PATH="./data/app.db"

# اختياري: مجلد دائم لحفظ صور المنتجات المرفوعة من العملاء (بدلاً من
# public/uploads/user). اضبطه على Persistent Volume في الإنتاج، خصوصًا على
# استضافات serverless مثل Vercel حيث نظام الملفات للقراءة فقط فيما عدا /tmp.
# مثال: KK_UPLOADS_DIR="/var/data/uploads"
# KK_UPLOADS_DIR=""

# رابط الموقع (يُستخدم في روابط المنتجات داخل رسائل واتساب) — بدون شرطة مائلة في النهاية
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------
# (اختياري) الإرسال التلقائي من الخادم عبر WhatsApp Cloud API
# بدونهما يعمل النظام بشكل كامل عبر فتح رابط wa.me تلقائيًا للعميل،
# ومعهما يصل الطلب لرقم المالك حتى لو لم يُكمل العميل فتح واتساب.
# ------------------------------------------------------------------
# KK_WHATSAPP_TOKEN="EAAG..."
# KK_WHATSAPP_PHONE_ID="123456789012345"
